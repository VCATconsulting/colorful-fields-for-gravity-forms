<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards based custom ruleset for your plugin">
	<description>Generally-applicable sniffs for WordPress plugins.</description>
	<!--
	#############################################################################
	COMMAND LINE ARGUMENTS
	https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
	#############################################################################
	-->

	<!-- Pass some flags to PHPCS:
		 p flag: Show progress of the run.
		 s flag: Show sniff codes in all reports.
	-->
	<arg value="ps"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<!-- Parallel files (20 is fine, comment was outdated) -->
	<arg name="parallel" value="20"/>

	<!-- Only check the PHP. CSS/SCSS/JS files are checked separately with linters. -->
	<arg name="extensions" value="php"/>

	<!-- Enable colors -->
	<arg name="colors"/>

	<!-- Check all files in this directory and the directories below it. -->
	<file>.</file>

	<!-- Exclude external / generated resources -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Exclude minified assets -->
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!--
	#############################################################################
	USE THE WordPress RULESET
	#############################################################################
	-->

	<rule ref="WordPress">
		<!-- Keep whichever array syntax you prefer; these two lines disable BOTH checks. -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax.Found"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
		<!-- Uncomment if you develop a theme with templates for CPTs having a prefix -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Uncomment for projects using the metabox toolbox -->
		<!--<exclude name="WordPress.CSRF.NonceVerification.NoNonceVerification" />-->
		<!-- Uncomment if you want to use some functions that should be replaced with the VIP cached alternatives -->
		<!--<exclude name="WordPress.VIP.RestrictedFunctions" />-->
		<!--<exclude name="WordPress.VIP.PostsPerPage" />-->
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax.Found"/>

	<!--
	#############################################################################
	SNIFF SPECIFIC CONFIGURATION
	#############################################################################
	-->

	<!-- Verify that the text_domain is set to the desired text-domain.
		 Multiple valid text domains can be provided as a comma-delimited list. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="colorful-fields-for-gravity-forms"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="5.7"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<property name="prefixes" type="array">
			<element value="cffgf"/>
		</property>
	</rule>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!--
	#############################################################################
	USE THE PHPCompatibility RULESET
	#############################################################################
	-->

	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="7.4-"/>
	<!-- https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>

</ruleset>
